        ax_reward.plot(
            rewards_history,
            color="cyan",
            linewidth=1.4,
            alpha=0.70,
            label="reward"
        )

        if len(rewards_history) >= 10:
            moving = np.convolve(
                rewards_history,
                np.ones(10) / 10,
                mode="valid"
            )

            ax_reward.plot(
                range(9, len(rewards_history)),
                moving,
                color="yellow",
                linewidth=2.6,
                label="média móvel"
            )

        ax_reward.legend(loc="upper left", fontsize=8, framealpha=0.25)


def draw_metrics_graph():
    ax_metrics.clear()

    ax_metrics.set_title("Exploração vs sucesso recente", fontsize=12, pad=8)
    ax_metrics.set_xlabel("Episódio", fontsize=9)
    ax_metrics.set_ylabel("%", fontsize=9)
    ax_metrics.set_ylim(0, 105)
    ax_metrics.grid(True, alpha=0.25)
    ax_metrics.tick_params(labelsize=8)

    if len(rewards_history) > 0:
        epsilon_line = []

        for i in range(len(rewards_history)):
            estimated = max(epsilon_min, 1.0 * (epsilon_decay ** i))
            epsilon_line.append(estimated * 100)

        ax_metrics.plot(
            epsilon_line,
            color="orange",
            linewidth=2,
            linestyle="--",
            label="exploração epsilon"
        )

        if len(episode_success_full) > 0:
            window_rates = []
            for i in range(len(episode_success_full)):
                window = episode_success_full[max(0, i - 49):i + 1]
                rate = sum(window) / len(window) * 100
                window_rates.append(rate)

            ax_metrics.plot(
                window_rates,
                color="lime",
                linewidth=2.5,
                label="sucesso últimos 50"
            )

        ax_metrics.legend(loc="upper right", fontsize=8, framealpha=0.25)


def draw_value_heatmap():
    global colorbar

    ax_value.clear()

    mode = has_package

    if mode == 0:
        title = "Heatmap da Q-table | buscando pacote"
    else:
        title = "Heatmap da Q-table | carregando pacote"

    ax_value.set_title(title, fontsize=12, pad=8)

    values = np.zeros((GRID_SIZE, GRID_SIZE))

    for i in range(GRID_SIZE):
        for j in range(GRID_SIZE):
            pos = (i, j)

            if pos in OBSTACLES:
                values[i, j] = -999
            else:
                values[i, j] = get_value(pos, mode)

    masked_values = np.ma.masked_where(values == -999, values)

    finite_values = values[values != -999]

    if len(finite_values) > 0:
        vmin = np.percentile(finite_values, 5)
        vmax = np.percentile(finite_values, 95)

        if abs(vmax - vmin) < 0.001:
            vmax = vmin + 1
    else:
        vmin, vmax = -1, 1

    heatmap = ax_value.imshow(
        masked_values,
        cmap="viridis",
        interpolation="nearest",
        vmin=vmin,
        vmax=vmax
    )

    # Obstáculos por cima: evita falhas pretas por NaN/interpolação
    for obs in OBSTACLES:
        ax_value.add_patch(
            plt.Rectangle(
                (obs[1] - 0.5, obs[0] - 0.5),
                1,
                1,
                color="black",
                alpha=0.85
            )
        )

    ax_value.plot(
        state[1],
        state[0],
        "o",
        color="white",
        markersize=8
    )

    ax_value.set_xticks([])
    ax_value.set_yticks([])

    ax_value.text(
        0.02,
        -0.07,
        "Mais claro = maior valor esperado. Preto = obstáculo.",
        transform=ax_value.transAxes,
        fontsize=9
    )

    ax_value.text(
        GRID_SIZE - 1,
        0,
        "ALTO",
        color="white",
        fontsize=8,
        ha="right",
        va="top"
    )

    ax_value.text(
        GRID_SIZE - 1,
        GRID_SIZE - 1,
        "BAIXO",
        color="white",
        fontsize=8,
        ha="right",
        va="bottom"
    )

    # Colorbar única e estável
    if colorbar is None:
        colorbar = fig.colorbar(
            heatmap,
            ax=ax_value,
            fraction=0.035,
            pad=0.02
