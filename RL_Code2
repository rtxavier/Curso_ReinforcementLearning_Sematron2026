# =========================================================
# LOOP
# =========================================================

def update(frame):
    global episode
    global state
    global has_package
    global step_counter
    global total_reward
    global epsilon
    global training_finished
    global current_path

    if not training_finished:

        steps_per_frame = 35

        for _ in range(steps_per_frame):

            if episode >= episodes:
                training_finished = True
                break

            action = choose_action(state, has_package)

            next_state, next_has_package, reward, done = environment_step(
                state,
                has_package,
                action
            )

            x, y = state
            nx, ny = next_state

            old_q = q_table[x, y, has_package, action]
            future_q = np.max(q_table[nx, ny, next_has_package])

            q_table[x, y, has_package, action] = old_q + alpha * (
                reward + gamma * future_q - old_q
            )

            state = next_state
            has_package = next_has_package

            total_reward += reward
            step_counter += 1
            current_path.append(state)

            if done or step_counter >= max_steps:

                rewards_history.append(total_reward)
                success_history.append(1 if done else 0)
                episode_success_full.append(1 if done else 0)

                episode += 1

                state = START
                has_package = 0
                step_counter = 0
                total_reward = 0
                current_path = [START]

                epsilon = max(
                    epsilon_min,
                    epsilon * epsilon_decay
                )

    draw_map()
    draw_reward_graph()
    draw_metrics_graph()
    draw_value_heatmap()
    draw_sensors_panel()
    draw_info_panel()


