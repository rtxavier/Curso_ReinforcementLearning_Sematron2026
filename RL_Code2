GRID_SIZE = 12

START = (0, 0)
PACKAGE = (9, 2)
HOSPITAL = (11, 11)

OBSTACLES = {
    (1, 3), (2, 3), (3, 3), (4, 3),
    (6, 1), (6, 2), (6, 3), (6, 4),
    (2, 7), (3, 7), (4, 7), (5, 7),
    (8, 6), (8, 7), (8, 8),
    (10, 4), (10, 5), (10, 6)
}

DANGER_ZONES = {
    (3, 1), (4, 1),
    (5, 5), (6, 5),
    (7, 9), (9, 9),
    (10, 9)
}

ACTIONS = {
    0: (-1, 0),  # cima
    1: (1, 0),   # baixo
    2: (0, -1),  # esquerda
    3: (0, 1)    # direita
}

ACTION_SYMBOLS = {
    0: "↑",
    1: "↓",
    2: "←",
    3: "→"
}

DIRECTION_NAMES = {
    0: "cima",
    1: "baixo",
    2: "esquerda",
    3: "direita",
    4: "no alvo"
}

# Estado simples:
# linha, coluna, carregando pacote, ação
q_table = np.zeros((GRID_SIZE, GRID_SIZE, 2, 4))

alpha = 0.18
gamma = 0.95

epsilon = 1.0
epsilon_decay = 0.965
epsilon_min = 0.03

episodes = 300
