episode_success_full = []
current_path = [START]

training_finished = False
colorbar = None


# =========================================================
# AMBIENTE
# =========================================================

def valid_position(pos):
    x, y = pos

    if x < 0 or x >= GRID_SIZE:
        return False

    if y < 0 or y >= GRID_SIZE:
        return False

    if pos in OBSTACLES:
        return False

    return True


def manhattan(a, b):
    return abs(a[0] - b[0]) + abs(a[1] - b[1])


# =========================================================
# SENSORES VISUAIS
# =========================================================

def obstacle_sensor(pos):
    """
    Sensor 1: radar de obstáculo.
    Retorna valores de 0 a 1 para cima, baixo, esquerda e direita.
    Quanto maior, mais livre está a direção.
    """

    readings = []

    for action in [0, 1, 2, 3]:
        dx, dy = ACTIONS[action]
        distance = 0
        current = pos

        while distance < 4:
            nxt = (current[0] + dx, current[1] + dy)

            if not valid_position(nxt):
                break

            distance += 1
            current = nxt

        readings.append(distance / 4)

    return readings


def danger_sensor(pos):
    """
    Sensor 2: proximidade de zona de risco.
    0 = seguro
    1 = muito perigoso
    """

    min_dist = 99

    for danger in DANGER_ZONES:
        d = manhattan(pos, danger)
        min_dist = min(min_dist, d)

    return max(0, 1 - min_dist / 5)


def target_sensor(pos, has_package):
    """
    Sensor 3: bússola para o objetivo atual.
    Antes do pacote, aponta para PACKAGE.
    Depois do pacote, aponta para HOSPITAL.
    """

    target = PACKAGE if has_package == 0 else HOSPITAL

    dx = target[0] - pos[0]
    dy = target[1] - pos[1]

    if dx == 0 and dy == 0:
        return 4, (0, 0)

    if abs(dx) > abs(dy):
        if dx < 0:
            return 0, (dx, dy)
        return 1, (dx, dy)

    if dy < 0:
        return 2, (dx, dy)

    return 3, (dx, dy)


def get_all_sensors(pos, has_package):
    radar = obstacle_sensor(pos)
    danger = danger_sensor(pos)
    target_dir, target_vector = target_sensor(pos, has_package)

    return radar, danger, target_dir, target_vector


# =========================================================
# Q-LEARNING
# =========================================================

def choose_action(pos, mode):
    global epsilon

    if random.random() < epsilon:
        return random.choice(list(ACTIONS.keys()))

    x, y = pos
    return np.argmax(q_table[x, y, mode])


def environment_step(pos, mode, action):
    dx, dy = ACTIONS[action]

    next_pos = (
        pos[0] + dx,
        pos[1] + dy
    )

    reward = -1
    done = False
    next_mode = mode

    # Colisão com parede/obstáculo
    if not valid_position(next_pos):
        return pos, mode, -15, False

    # Zona perigosa
    if next_pos in DANGER_ZONES:
        reward -= 12

    # Pegou pacote
    if next_pos == PACKAGE and mode == 0:
        reward += 80
        next_mode = 1

    # Chegou ao hospital sem pacote
    if next_pos == HOSPITAL and mode == 0:
        reward -= 5

    # Entregou pacote
    if next_pos == HOSPITAL and mode == 1:
        reward += 150
        done = True

    # Reward shaping por aproximação ao alvo certo
    target = PACKAGE if mode == 0 else HOSPITAL

    old_dist = manhattan(pos, target)
    new_dist = manhattan(next_pos, target)

    if new_dist < old_dist:
        reward += 2
    else:
        reward -= 1

    return next_pos, next_mode, reward, done


def get_best_action(pos, mode):
    x, y = pos
    return np.argmax(q_table[x, y, mode])


def get_value(pos, mode):
    x, y = pos
    return np.max(q_table[x, y, mode])


def get_policy_strength(pos, mode):
    x, y = pos
    values = q_table[x, y, mode]
    return np.max(values) - np.min(values)


